{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meeshogi-analysis-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "AnalysisContainer",
      // Private digest-pinned image, built from an external 0700 context; engine/weight are never committed.
      "image": "registry.cloudflare.com/0c28583a22fe4051144d6efdb783d3b0/meeshogi-analysis-staging@sha256:145d3983afee3cd2aceaec5af9f91abb8a47f49be86f2a77ba60063f5b2f4cda",
      // Select the instance size only for the serial benchmark; see docs/CLOUD.md for documented specs.
      // Main must verify account availability and current limits before deployment.
      "instance_type": "standard-3",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ANALYSIS_CONTAINER", "class_name": "AnalysisContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnalysisContainer"] }
  ],
  "vars": {
    "ANALYSIS_PROFILE_ID": "fixed-sfen-staging-v1",
    "ANALYSIS_PROFILE_VERSION": "1",
    "ANALYSIS_MODEL_ID": "analysis-model-staging-v1"
  }
}
