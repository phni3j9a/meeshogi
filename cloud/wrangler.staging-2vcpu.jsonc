{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meeshogi-analysis-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "AnalysisContainer",
      // Private digest-pinned image, built from an external 0700 context; engine/weight are never committed.
      "image": "registry.cloudflare.com/0c28583a22fe4051144d6efdb783d3b0/meeshogi-analysis-staging@sha256:84599cdf775dea33fcd62860eda67fc2ab8bf047ce9fb2012fcddd9e86b4c6cc",
      // Select the instance size only for the serial benchmark; see docs/CLOUD.md for documented specs.
      // Main must verify account availability and current limits before deployment.
      "instance_type": "standard-3",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ANALYSIS_CONTAINER", "class_name": "AnalysisContainer" },
      { "name": "JOB_COORDINATOR", "class_name": "JobCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnalysisContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["JobCoordinator"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meeshogi-analysis-staging-db",
      "database_id": "c2260c42-3565-4780-964e-937335c9a0a7",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "JOB_QUEUE", "queue": "meeshogi-analysis-staging-jobs" }
    ],
    "consumers": [
      {
        "queue": "meeshogi-analysis-staging-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "meeshogi-analysis-staging-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "vars": {
    "ANALYSIS_PROFILE_ID": "fixed-sfen-staging-v1",
    "ANALYSIS_PROFILE_VERSION": "1",
    "ANALYSIS_MODEL_ID": "analysis-model-staging-v1",
    "ANALYSIS_ENGINE_ID": "YaneuraOu NNUE 9.70git 64AVX2",
    "ANALYSIS_INSTANCE_TYPE": "standard-3"
  }
}
