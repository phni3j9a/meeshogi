{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meeshogi-analysis-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "AnalysisContainer",
      // Private image: built from an external 0700 context by scripts/prepare-private-context.sh
      // + `wrangler containers build -p`; the engine/weight are never committed to this repo.
      "image": "registry.cloudflare.com/0c28583a22fe4051144d6efdb783d3b0/meeshogi-analysis-staging@sha256:ae00a072a0d82f233079c1a1d179a0600397e232feb7487cd36758b648c076dd",
      // Cloudflare Containers documents standard-2 as 1 vCPU, 6 GiB memory, and 12 GB disk.
      // Main must verify account availability and the current limits reference before deployment.
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ANALYSIS_CONTAINER", "class_name": "AnalysisContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnalysisContainer"] }
  ],
  "vars": {
    "ANALYSIS_PROFILE_ID": "fixed-sfen-staging-v1",
    "ANALYSIS_PROFILE_VERSION": "1",
    "ANALYSIS_MODEL_ID": "analysis-model-staging-v1"
  }
}
