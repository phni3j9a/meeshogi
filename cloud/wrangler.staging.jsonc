{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meeshogi-analysis-mvp-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "account_id": "__ACCOUNT_ID__",
  "workers_dev": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0
  },
  "durable_objects": {
    "bindings": [
      { "name": "ANALYSIS_CONTAINER", "class_name": "AnalysisContainer" },
      { "name": "ANALYSIS_BENCHMARK_STANDARD_2", "class_name": "BenchmarkStandard2Container" },
      { "name": "ANALYSIS_BENCHMARK_STANDARD_3", "class_name": "BenchmarkStandard3Container" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnalysisContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["BenchmarkStandard2Container", "BenchmarkStandard3Container"] }
  ],
  "containers": [
    {
      "name": "meeshogi-analysis-mvp-staging-analysis",
      "class_name": "AnalysisContainer",
      "image": "registry.cloudflare.com/__ACCOUNT_ID__/meeshogi-analysis-mvp-staging@sha256:__IMAGE_DIGEST__",
      "max_instances": 1,
      "instance_type": "standard-2"
    },
    {
      "name": "meeshogi-analysis-mvp-staging-benchmark-standard-2",
      "class_name": "BenchmarkStandard2Container",
      "image": "registry.cloudflare.com/__ACCOUNT_ID__/meeshogi-analysis-mvp-staging@sha256:__IMAGE_DIGEST__",
      "max_instances": 1,
      "instance_type": "standard-2"
    },
    {
      "name": "meeshogi-analysis-mvp-staging-benchmark-standard-3",
      "class_name": "BenchmarkStandard3Container",
      "image": "registry.cloudflare.com/__ACCOUNT_ID__/meeshogi-analysis-mvp-staging@sha256:__IMAGE_DIGEST__",
      "max_instances": 1,
      "instance_type": "standard-3"
    }
  ],
  "d1_databases": [
    {
      "binding": "JOBS_DB",
      "database_name": "meeshogi-jobs-staging",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_table": "d1_migrations_jobs",
      "preview_database_id": "__D1_DATABASE_ID__"
    }
  ],
  "queues": {
    "producers": [
      { "queue": "meeshogi-jobs-staging", "binding": "JOBS_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "meeshogi-jobs-staging",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3,
        "dead_letter_queue": "meeshogi-jobs-staging-dlq",
        "max_concurrency": 1,
        "visibility_timeout_ms": 900000
      }
    ]
  }
}
