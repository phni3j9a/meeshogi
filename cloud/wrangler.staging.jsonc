{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meeshogi-analysis-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "AnalysisContainer",
      // Private digest-pinned image, built from an external 0700 context; engine/weight are never committed.
      "image": "registry.cloudflare.com/0c28583a22fe4051144d6efdb783d3b0/meeshogi-analysis-staging@sha256:410b92aa12489e1f58cf40ec04ff61364dca12cd9b6824be8858df623ba9ddf4",
      "instance_type": "standard-2",
      "max_instances": 1
    },
    {
      "class_name": "AnalysisContainerPrecision",
      "image": "registry.cloudflare.com/0c28583a22fe4051144d6efdb783d3b0/meeshogi-analysis-staging@sha256:410b92aa12489e1f58cf40ec04ff61364dca12cd9b6824be8858df623ba9ddf4",
      "instance_type": "standard-3",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ANALYSIS_CONTAINER", "class_name": "AnalysisContainer" },
      { "name": "ANALYSIS_CONTAINER_PRECISION", "class_name": "AnalysisContainerPrecision" },
      { "name": "JOB_COORDINATOR", "class_name": "JobCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnalysisContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["JobCoordinator"] },
    { "tag": "v3", "new_sqlite_classes": ["AnalysisContainerPrecision"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meeshogi-analysis-staging-db",
      "database_id": "c2260c42-3565-4780-964e-937335c9a0a7",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "JOB_QUEUE", "queue": "meeshogi-analysis-staging-jobs" }
    ],
    "consumers": [
      {
        "queue": "meeshogi-analysis-staging-jobs",
        "max_batch_size": 1,
        "max_retries": 5,
        "dead_letter_queue": "meeshogi-analysis-staging-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "meeshogi-analysis-staging-dlq",
        "max_batch_size": 1,
        "max_retries": 1,
        "max_concurrency": 1
      }
    ]
  },
  "vars": {
    "ANALYSIS_MODEL_ID": "analysis-model-staging-v1",
    "ANALYSIS_ENGINE_ID": "YaneuraOu NNUE 9.70git 64AVX2",
    "ANALYSIS_ENGINE_BINARY_DIGEST_LABEL": "sha256:0cb27c8302f6eb357cd360372defe172401519c06fb4bf28eb2bf72ee0f39d80",
    "ANALYSIS_WEIGHT_SHA256": "a78b7f889843037d344f482623b3febd124ead5c1f34f134d9f1c2c78cd0f829",
    "ANALYSIS_ENGINE_OPTIONS_SHA256": "9c242cd8820c158292af4a6d58890e37ae060000a9a6344d7a549abf7f44f0b3",
    "ANALYSIS_HELPER_SHA256": "776e6204f89c03288e6105f295b155e1dd716e79e18722762bd15280f6a0f6da",
    "ANALYSIS_DRIVER_SHA256": "54ffb370e9e70d3ccaec252022a4782fabb5e9214d3244423c6446b42624e438",
    "ANALYSIS_FAULT_FIXTURES_ENABLED": "0",
    "ANALYSIS_FAULT_TEST_PRINCIPAL_ID": "prn-main",
    "ANALYSIS_DAILY_COST_CAP_USD": "1"
  },
  "triggers": { "crons": ["* * * * *"] }
}
