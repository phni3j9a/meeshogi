{
  "name": "meeshogi-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "tsshogi": "2.3.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260924.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.139.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:ts": "vitest run",
    "test:python": "python3 -m unittest discover -s container -p 'test_*.py' -v && python3 -m unittest discover -s bench/test -p 'test_*.py' -v",
    "test": "npm run test:ts && npm run test:python",
    "check": "npm run typecheck && npm test"
  }
}
